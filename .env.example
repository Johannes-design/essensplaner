# Pflicht für echte Pläne: API-Schlüssel von https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: anderes Modell (Standard: claude-sonnet-5-5). Gründlicher, doppelt so teuer: claude-opus-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: 1 = Beispieldaten statt echter Angebote/KI (zum Ausprobieren)
# DEMO_MODE=1
